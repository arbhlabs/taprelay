<?xml version="1.0" encoding="utf-8"?>
<!-- Action Key at its default size (roughly 2x1): icon, name, and what it will do. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_surface"
    android:padding="14dp"
    android:theme="@style/Theme.TapRelayWidget">

    <ImageView
        android:id="@+id/key_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_w_scene"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/key_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:text="@string/widget_default_name" />

        <TextView
            android:id="@+id/key_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widget_text_dim"
            android:text="@string/widget_default_detail" />
    </LinearLayout>

    <ImageView
        android:id="@+id/key_status"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        android:src="@drawable/ic_w_check"
        android:contentDescription="@null" />
</LinearLayout>
