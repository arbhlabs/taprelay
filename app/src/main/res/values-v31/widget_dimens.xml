<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher tells us the exact radius it is clipping the widget to. Using anything else is
    what makes a widget look subtly wrong against every other one on the home screen.
-->
<resources>
    <dimen name="widget_radius">@android:dimen/system_app_widget_background_radius</dimen>
    <dimen name="widget_inner_radius">@android:dimen/system_app_widget_inner_radius</dimen>
</resources>
