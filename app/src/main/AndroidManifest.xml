<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Places. Background location is what lets a geofence fire while TapRelay is closed;
         it is requested separately and only after the owner has added a place. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <!-- Logging into LastDose without opening it. The provider on the other side also pins our signature. -->
    <uses-permission android:name="com.lastdose.app.permission.EXTERNAL_ACTION" />

    <!-- Android 11+ package visibility: without this the LastDose provider is simply invisible. -->
    <queries>
        <package android:name="com.lastdose.app" />
    </queries>

    <application
        android:name=".TapRelayApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.TapRelay"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TapRelay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Caller-authenticated AOD controller forwarding from the LastDose foreground window. -->
        <provider
            android:name=".external.LastDoseControllerProvider"
            android:authorities="com.arbhlabs.taprelay.aod_controller"
            android:exported="true" />

        <!--
            Controller-in-any-app. An opt-in accessibility service is the only way Android lets a
            mapped gamepad button fire from outside the focused window. flagRequestFilterKeyEvents
            routes key events here first; no window content is read. Nothing runs until the owner
            enables it in Accessibility settings. Remote Mode below stays the zero-setup option.
        -->
         <service
             android:name=".controller.GlobalControllerService"
             android:exported="true"
             android:label="@string/global_controller_a11y_label"
             android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/global_controller_service" />
        </service>

        <!--
            Remote Mode. Shows over the lock screen and wakes the display so the phone can sit
            docked and be driven by a game controller. A normal foreground activity - no overlay
            permission and no accessibility service needed to use it.
        -->
        <activity
            android:name=".ui.remote.RemoteModeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.TapRelay" />

        <service
            android:name=".ui.remote.RemoteModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_remote"
            android:label="@string/remote_mode_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.quick.QuickControlsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TapRelay.Transparent" />

        <!-- Holds D-pad focus only during the 20 s light window when TapRelay is not on screen.
             Own empty task affinity so launching it never brings TapRelay's main task forward. -->
        <activity
            android:name=".ui.LightAdjustHudActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.TapRelay.Transparent" />

        <activity
            android:name=".ui.NfcTrampolineActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.TapRelay.Transparent">

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="taprelay.app"
                    android:pathPrefix="/t/" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="https"
                    android:host="taprelay.app"
                    android:pathPrefix="/t/" />
            </intent-filter>
        </activity>

        <!--
            Home-screen widgets. No updatePeriodMillis: a widget is redrawn when something
            happened to it, never on a timer.
        -->
        <receiver
            android:name=".widget.ActionKeyWidget"
            android:exported="false"
            android:label="@string/widget_key_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_key_info" />
        </receiver>

        <receiver
            android:name=".widget.RemoteWidget"
            android:exported="false"
            android:label="@string/widget_remote_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_remote_info" />
        </receiver>

        <!-- Not exported: only TapRelay's own PendingIntents may run an owner's action. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TapRelay">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".location.GeofenceReceiver"
            android:exported="false" />

        <!-- Android drops every geofence on reboot, so they are rebuilt from the database. -->
        <receiver
            android:name=".location.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
